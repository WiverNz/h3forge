{
  "identifier": "main",
  "description": "Only the local main window can request application information and inspect savegames it opened.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-get-ui-languages",
    "allow-choose-save",
    "allow-open-granted-save",
    "allow-list-heroes",
    "allow-get-hero",
    "allow-get-installation-status",
    "allow-choose-installation",
    "allow-get-hero-portrait",
    "allow-get-hero-portraits",
    "allow-apply-hero-edit",
    "allow-get-hero-edit-state",
    "allow-get-pending-edits",
    "allow-discard-hero-edits",
    "allow-set-hero-dismissal",
    "allow-discard-all-edits",
    "allow-list-towns",
    "allow-list-players",
    "allow-list-neutral-armies",
    "allow-apply-neutral-edit",
    "allow-discard-neutral-edits",
    "allow-apply-tent-edit",
    "allow-apply-team-edit",
    "allow-get-keymaster-icon",
    "allow-get-player-flag",
    "allow-get-player-starting-portrait",
    "allow-apply-player-edit",
    "allow-discard-player-edits",
    "allow-get-resource-icon",
    "allow-get-town",
    "allow-apply-town-edit",
    "allow-get-town-edit-state",
    "allow-discard-town-edits",
    "allow-save-save-as",
    "allow-save",
    "allow-get-creature-portrait",
    "allow-get-spell-icon",
    "allow-get-town-icon",
    "allow-get-building-icon",
    "allow-get-skill-icon",
    "allow-get-artifact-icon",
    "allow-get-map-link",
    "allow-rescan-maps",
    "allow-select-map-candidate",
    "allow-choose-map-file",
    "core:window:allow-set-title"
  ]
}
